# Base image is overridable so a release can pin a scanned 0-Critical/0-High
# digest (see eval/verifier/SUPPLY_CHAIN.md). The grader runs the model's code,
# so a clean base matters most here.
ARG BASE_IMAGE=python:3.12-slim@sha256:423ed6ab25b1921a477529254bfeeabf5855151dc2c3141699a1bfc852199fbf
FROM ${BASE_IMAGE}

RUN python -m pip install --no-cache-dir pytest==9.1.1

COPY uv-shim /usr/local/bin/uv
COPY subject_worker.py /usr/local/bin/grader-subject
COPY hidden /opt/grader/tests

RUN chmod 0755 /usr/local/bin/uv /usr/local/bin/grader-subject \
    && chmod -R 0700 /opt/grader/tests \
    && mkdir -p /workspace

ENV PYTHONPATH=/opt/grader/tests

WORKDIR /workspace
